# Copy to .env for `docker compose`, or paste these into Portainer's stack "Environment variables".
HOST_PORT=8088
TZ=Pacific/Auckland

BASIC_AUTH_USER=adam
BASIC_AUTH_PASSWORD=change-me

PUBLIC_URL=http://192.168.1.50:8088

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: skip the /strava/connect step by pasting a refresh token with activity:read_all scope
STRAVA_REFRESH_TOKEN=

GARMIN_EMAIL=
GARMIN_PASSWORD=
GARMIN_REFRESH_TIME=05:45

WEATHER_LAT=-36.8485
WEATHER_LON=174.7633
