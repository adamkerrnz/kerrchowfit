# KerrChow Fit, self-hosted: copy to .env next to docker-compose.yml. See DOCKER.md.
HOST_PORT=8088
TZ=Pacific/Auckland
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
PUBLIC_URL=

# Strava and Garmin credentials can also be entered on the Stats tab instead.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
GARMIN_PERSONAL_API_KEY=
# Daily refresh time (weather, classes, Garmin, Strava). Empty = off, e.g. when host cron runs `python -m app.daily`.
DAILY_REFRESH_TIME=05:40

WEATHER_LAT=-36.8485
WEATHER_LON=174.7633
LESMILLS_CLUB=01
LESMILLS_TIME=07:10
